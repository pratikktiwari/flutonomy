---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import LessonList from '../../components/site/LessonList.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Lessons">
  <div class="container">
    <PageHeader
      eyebrow="Learn"
      title="A path from first breath to first raag"
      lead="Short lessons with the tools built in — read a little, then play along right on the page."
    />
    <LessonList lessons={lessons} />
  </div>
</BaseLayout>
