---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import ToolTile from '../components/ui/ToolTile.astro';
import LessonList from '../components/site/LessonList.astro';
import { TOOLS } from '../lib/tools';
import { url } from '../lib/url';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  { n: '01', title: 'Tune', hindi: 'सुर', text: 'Start the tanpura in your flute’s key. Listen for a minute before you play.', href: '/tools/tanpura' },
  { n: '02', title: 'Breathe', hindi: 'साँस', text: 'Long, steady Sa. Watch the tuner trace stay flat and green.', href: '/tools/tuner' },
  { n: '03', title: 'Play', hindi: 'रियाज़', text: 'Alankars with the taal. Slow first, then a little faster each day.', href: '/tools/alankar' },
];
---

<BaseLayout>
  <section class="hero container">
    <div class="hero__text">
      <p class="eyebrow">Bansuri practice studio</p>
      <h1 class="hero__title">Breathe.<br />Listen. <em>Play.</em></h1>
      <p class="hero__lead">
        Tanpura, tabla, tuner and gentle lessons for the Indian bamboo flute — all in your key, all in the browser.
      </p>
      <div class="cluster hero__cta">
        <a class="btn btn--primary btn--lg" href={url('/practice')}><Icon name="play" size={16} /> Open the practice room</a>
        <a class="btn btn--lg btn--ghost" href={url('/lessons/01-first-sound')}>Start lesson 1 <Icon name="arrow" size={16} /></a>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg viewBox="0 0 400 320">
        <defs>
          <linearGradient id="hero-bamboo" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e7cf98" />
            <stop offset=".55" stop-color="#c9a663" />
            <stop offset="1" stop-color="#8f6b2f" />
          </linearGradient>
          <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="var(--color-accent)" stop-opacity=".45" />
            <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="200" cy="160" r="150" fill="url(#hero-glow)" class="hero__glow" />
        <g class="hero__waves" fill="none" stroke-linecap="round">
          <path class="w w1" d="M-20 160 C 40 110, 80 110, 120 160 S 200 210, 240 160 S 320 110, 420 160" />
          <path class="w w2" d="M-20 160 C 50 125, 90 125, 130 160 S 210 195, 250 160 S 330 125, 420 160" />
          <path class="w w3" d="M-20 160 C 60 140, 100 140, 140 160 S 220 180, 260 160 S 340 140, 420 160" />
        </g>
        <g transform="rotate(-18 200 160)">
          <rect x="40" y="148" width="320" height="24" rx="12" fill="url(#hero-bamboo)" />
          <rect x="62" y="148" width="4" height="24" fill="rgb(0 0 0 / .18)" />
          <rect x="330" y="148" width="4" height="24" fill="rgb(0 0 0 / .18)" />
          <ellipse cx="86" cy="160" rx="7" ry="5.5" fill="#2a1c0c" />
          {[170, 196, 222, 262, 288, 314].map((x) => <circle cx={x} cy="160" r="6" fill="#2a1c0c" />)}
        </g>
      </svg>
    </div>
  </section>

  <section class="container section">
    <div class="section__head">
      <p class="eyebrow">A simple daily riyaz</p>
      <h2>Three steps, fifteen minutes</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <a href={url(s.href)} class="step">
              <span class="step__n">{s.n}</span>
              <span class="step__title">
                {s.title} <span lang="hi">{s.hindi}</span>
              </span>
              <span class="step__text">{s.text}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section">
    <div class="section__head">
      <p class="eyebrow">Tools</p>
      <h2>Your accompanists</h2>
    </div>
    <div class="grid-auto" style="--grid-min: 19rem">
      {TOOLS.map((t) => <ToolTile {...t} />)}
    </div>
  </section>

  <section class="container section">
    <div class="section__head section__head--row">
      <div>
        <p class="eyebrow">Lessons</p>
        <h2>Learn by playing along</h2>
      </div>
      <a href={url('/lessons')} class="btn btn--ghost">All lessons <Icon name="arrow" size={16} /></a>
    </div>
    <LessonList lessons={lessons.slice(0, 5)} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-10);
    align-items: center;
    min-height: min(72vh, 40rem);
    padding-block: var(--space-8) var(--space-12);
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero__art {
      order: -1;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
  .hero__text {
    display: grid;
    gap: var(--space-5);
  }
  .hero__title {
    font-size: clamp(3rem, 1.8rem + 5vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 400;
  }
  .hero__title em {
    color: var(--color-accent);
    font-style: italic;
  }
  .hero__lead {
    max-width: 34rem;
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: var(--leading-snug);
  }
  .hero__cta {
    margin-top: var(--space-2);
  }
  .hero__art svg {
    width: 100%;
    overflow: visible;
  }
  .hero__glow {
    animation: breathe 7s var(--ease-in-out) infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .w {
    stroke-width: 1.5;
    animation: drift 9s linear infinite;
  }
  .w1 {
    stroke: var(--color-accent);
    opacity: 0.7;
  }
  .w2 {
    stroke: var(--color-khali);
    opacity: 0.5;
    animation-duration: 12s;
    animation-direction: reverse;
  }
  .w3 {
    stroke: var(--color-bamboo);
    opacity: 0.45;
    animation-duration: 15s;
  }
  @keyframes drift {
    from {
      stroke-dasharray: 6 10;
      stroke-dashoffset: 0;
    }
    to {
      stroke-dasharray: 6 10;
      stroke-dashoffset: -160;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(0.88);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  .section {
    margin-top: var(--space-20);
  }
  .section__head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .section__head h2 {
    font-size: var(--text-3xl);
  }
  .section__head--row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    counter-reset: step;
  }
  .step {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration-base);
  }
  .step:hover {
    border-color: var(--color-accent);
  }
  .step__n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
  }
  .step__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .step__title span {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-text-subtle);
  }
  .step__text {
    color: var(--color-text-muted);
    font-size: var(--text-md);
  }
</style>
