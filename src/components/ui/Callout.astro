---
/** Highlighted aside for lessons: tips, notes and "riyaz" practice prompts. */
interface Props {
  type?: 'tip' | 'note' | 'riyaz';
  title?: string;
}
const { type = 'tip', title } = Astro.props;
const defaults = { tip: 'Tip', note: 'Note', riyaz: 'Riyaz (practice)' };
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__title">{title ?? defaults[type]}</p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    --callout-color: var(--color-accent);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in oklab, var(--callout-color) 30%, transparent);
    background: color-mix(in oklab, var(--callout-color) 8%, var(--color-surface));
    font-size: var(--text-md);
  }
  .callout--note {
    --callout-color: var(--color-khali);
  }
  .callout--riyaz {
    --callout-color: var(--color-bamboo);
  }
  .callout__title {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--callout-color);
  }
  .callout__body :global(> * + *) {
    margin-top: var(--space-2);
  }
  .callout__body :global(p),
  .callout__body :global(li) {
    color: var(--color-text);
  }
</style>
