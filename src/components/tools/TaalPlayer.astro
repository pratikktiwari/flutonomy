---
import ToolCard from '../ui/ToolCard.astro';
import PlayButton from '../ui/PlayButton.astro';
import RangeField from '../ui/RangeField.astro';
import Segmented from '../ui/Segmented.astro';
import { TAALS, TAAL_BY_ID } from '../../lib/taals';

interface Props {
  taal?: string;
  bpm?: number;
  /** restrict the selector to these taals (e.g. in a lesson) */
  only?: string[];
  embedded?: boolean;
}
const { taal = 'teentaal', bpm, only, embedded = false } = Astro.props;
const list = only ? TAALS.filter((t) => only.includes(t.id)) : TAALS;
const initial = TAAL_BY_ID[taal] ?? TAALS[0];
---

<ToolCard
  title="Taal"
  hindi="ताल"
  icon="drum"
  href="/tools/taal"
  description={embedded ? undefined : 'Tabla theka with a live taal-chakra: see sam, taali and khali as the cycle turns.'}
>
  <div class="taal" data-tool="taal" data-taal={initial.id} data-bpm={bpm ?? initial.defaultBpm} data-lock={only ? 'true' : undefined}>
    {
      list.length > 1 && (
        <Segmented
          ref="taal"
          label="Choose taal"
          value={initial.id}
          options={list.map((t) => ({ value: t.id, label: `${t.name} · ${t.matras}` }))}
        />
      )
    }

    <div class="taal__main">
      <div class="taal__wheel-wrap">
        <svg class="taal__wheel" viewBox="0 0 340 340" data-ref="wheel" role="img" aria-label="Taal cycle"></svg>
        <div class="taal__center" aria-live="off">
          <span class="taal__matra" data-ref="matra">1</span>
          <span class="taal__bol" data-ref="bol">{initial.theka[0].join(' ')}</span>
          <span class="taal__avartan" data-ref="avartan">āvartan 0</span>
        </div>
      </div>

      <div class="taal__side">
        <p class="taal__feel muted" data-ref="feel">{initial.feel}</p>
        <div class="taal__legend">
          <span><i class="lg lg--sam"></i> Sam (X) — clap, the "one"</span>
          <span><i class="lg lg--taali"></i> Taali — clap</span>
          <span><i class="lg lg--khali"></i> Khali (0) — wave</span>
        </div>
        <RangeField label="Tempo" ref="tempo" min={20} max={320} value={bpm ?? initial.defaultBpm} unit=" bpm" />
        <div class="cluster">
          <Segmented
            ref="sound"
            label="Sound"
            value="tabla"
            options={[
              { value: 'tabla', label: 'Tabla' },
              { value: 'claps', label: 'Claps only' },
              { value: 'both', label: 'Both' },
            ]}
          />
          <span class="chip chip--accent" data-ref="laya">Madhya laya</span>
        </div>
        <div class="cluster">
          <PlayButton label="Play taal" />
          <span class="muted taal__hint">Tabla is tuned to your Sa.</span>
        </div>
      </div>
    </div>

    <div class="taal__grid" data-ref="grid" aria-label="Theka notation"></div>
  </div>
</ToolCard>

<script>
  import { Scheduler, audio, bus, noiseBuffer, registerStopper } from '../../lib/audio/engine';
  import { tablaStroke } from '../../lib/audio/voices';
  import { TAAL_BY_ID, matraInfo, layaFor, type Taal } from '../../lib/taals';
  import { mountAll, ref, maybeRef, bindRange, bindSegmented, setPressed } from '../../lib/dom';
  import { saHz, usePref } from '../../lib/settings';

  const SVG = 'http://www.w3.org/2000/svg';
  const el = (tag: string, attrs: Record<string, string | number>, parent?: Element) => {
    const n = document.createElementNS(SVG, tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    parent?.append(n);
    return n;
  };

  const markKind = (m: string | null) =>
    !m ? '' : m.startsWith('X') ? 'sam' : m === '0' ? 'khali' : 'taali';

  function clap(time: number, strong: boolean) {
    const c = audio();
    const out = bus('tabla');
    // a clap is a few very short noise bursts
    for (let i = 0; i < 3; i++) {
      const t = time + i * 0.009;
      const n = c.createBufferSource();
      n.buffer = noiseBuffer();
      const bp = c.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1300;
      bp.Q.value = 0.9;
      const g = c.createGain();
      const a = (strong ? 0.9 : 0.5) * (i === 2 ? 1 : 0.6);
      g.gain.setValueAtTime(a, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + (i === 2 ? 0.12 : 0.012));
      n.connect(bp).connect(g).connect(out);
      n.start(t, Math.random() * 0.8);
      n.stop(t + 0.15);
    }
  }

  function wave(time: number) {
    // khali: a soft "whoosh" so you can still feel it
    const c = audio();
    const n = c.createBufferSource();
    n.buffer = noiseBuffer();
    const lp = c.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = 900;
    const g = c.createGain();
    g.gain.setValueAtTime(0.0001, time);
    g.gain.linearRampToValueAtTime(0.18, time + 0.05);
    g.gain.exponentialRampToValueAtTime(0.0001, time + 0.18);
    n.connect(lp).connect(g).connect(bus('tabla'));
    n.start(time);
    n.stop(time + 0.2);
  }

  mountAll('taal', (root) => {
    const locked = root.dataset.lock === 'true';
    const pref = usePref('taal', { taal: root.dataset.taal!, bpm: Number(root.dataset.bpm), sound: 'tabla' });
    const saved = pref.get();
    let taal: Taal = TAAL_BY_ID[locked ? root.dataset.taal! : saved.taal] ?? TAAL_BY_ID[root.dataset.taal!];
    let bpm = locked ? Number(root.dataset.bpm) : saved.bpm;
    let sound = saved.sound;

    const wheel = ref(root, 'wheel') as unknown as SVGSVGElement;
    const grid = ref(root, 'grid');
    const matraOut = ref(root, 'matra');
    const bolOut = ref(root, 'bol');
    const avOut = ref(root, 'avartan');
    const feelOut = ref(root, 'feel');
    const layaOut = ref(root, 'laya');
    const playBtn = ref(root, 'play');

    let nodes: SVGGElement[] = [];
    let cells: HTMLElement[] = [];
    let pointer: SVGGElement;

    const save = () => !locked && pref.set({ taal: taal.id, bpm, sound });

    function render() {
      const info = matraInfo(taal);
      const N = taal.matras;
      const cx = 170, cy = 170, R = 128;
      wheel.innerHTML = '';

      // Vibhag arcs on the outer ring
      const ringR = R + 30;
      let start = 0;
      taal.vibhags.forEach((len, v) => {
        const kind = markKind(taal.marks[v]);
        const a0 = ((start - 0.42) / N) * Math.PI * 2 - Math.PI / 2;
        const a1 = ((start + len - 0.58) / N) * Math.PI * 2 - Math.PI / 2;
        const large = a1 - a0 > Math.PI ? 1 : 0;
        el('path', {
          d: `M ${cx + ringR * Math.cos(a0)} ${cy + ringR * Math.sin(a0)} A ${ringR} ${ringR} 0 ${large} 1 ${cx + ringR * Math.cos(a1)} ${cy + ringR * Math.sin(a1)}`,
          class: `taal__arc taal__arc--${kind}`,
        }, wheel);
        start += len;
      });

      // faint inner circle
      el('circle', { cx, cy, r: R, class: 'taal__track' }, wheel);

      // Sweep pointer (rotated per matra)
      pointer = el('g', { class: 'taal__pointer' }, wheel) as SVGGElement;
      el('line', { x1: cx, y1: cy - 62, x2: cx, y2: cy - R + 22 }, pointer);

      const nodeR = N > 12 ? 17 : 20;
      nodes = info.map((m, i) => {
        const a = (i / N) * Math.PI * 2 - Math.PI / 2;
        const x = cx + R * Math.cos(a);
        const y = cy + R * Math.sin(a);
        const kind = markKind(m.mark);
        const g = el('g', { class: `taal__node ${kind ? 'taal__node--' + kind : ''}` }, wheel) as SVGGElement;
        el('circle', { cx: x, cy: y, r: nodeR }, g);
        const label = el('text', { x, y: y + 4, 'text-anchor': 'middle', class: 'taal__node-num' }, g);
        label.textContent = String(i + 1);
        if (m.mark) {
          const mx = cx + (R + 30) * Math.cos(a);
          const my = cy + (R + 30) * Math.sin(a);
          el('circle', { cx: mx, cy: my, r: 11, class: 'taal__mark-bg' }, g);
          const t = el('text', { x: mx, y: my + 4, 'text-anchor': 'middle', class: 'taal__mark' }, g);
          t.textContent = m.mark === 'X0' ? 'X' : m.mark;
        }
        return g;
      });

      // Linear theka notation grouped by vibhag
      grid.innerHTML = '';
      cells = [];
      let i = 0;
      taal.vibhags.forEach((len, v) => {
        const group = document.createElement('div');
        group.className = `taal__vibhag taal__vibhag--${markKind(taal.marks[v])}`;
        const mark = document.createElement('span');
        mark.className = 'taal__vibhag-mark';
        mark.textContent = taal.marks[v] === 'X0' ? 'X' : taal.marks[v];
        group.append(mark);
        const row = document.createElement('div');
        row.className = 'taal__cells';
        for (let k = 0; k < len; k++, i++) {
          const c = document.createElement('div');
          c.className = 'taal__cell';
          c.innerHTML = `<span class="taal__cell-bol">${taal.theka[i].join('<wbr> ')}</span><span class="taal__cell-num">${i + 1}</span>`;
          row.append(c);
          cells.push(c);
        }
        group.append(row);
        grid.append(group);
      });

      feelOut.textContent = taal.feel;
      highlight(-1);
    }

    function highlight(matra: number) {
      nodes.forEach((n, i) => n.classList.toggle('is-on', i === matra));
      cells.forEach((c, i) => c.classList.toggle('is-on', i === matra));
      const m = Math.max(matra, 0);
      pointer.style.transform = `rotate(${(m / taal.matras) * 360}deg)`;
      pointer.classList.toggle('is-hidden', matra < 0);
      matraOut.textContent = String(m + 1);
      bolOut.textContent = taal.theka[m].join(' ');
    }

    const updateLaya = () => (layaOut.textContent = `${layaFor(bpm).label} laya`);

    const tempo = bindRange(root, 'tempo', (v) => {
      bpm = v;
      updateLaya();
      save();
    });
    tempo.set(bpm);
    updateLaya();

    const soundCtl = bindSegmented(root, 'sound', (v) => {
      sound = v;
      save();
    });
    soundCtl.select(sound);

    if (maybeRef(root, 'taal')) {
      const taalCtl = bindSegmented(root, 'taal', (v) => {
        const wasRunning = sched.running;
        if (wasRunning) stop();
        taal = TAAL_BY_ID[v];
        bpm = taal.defaultBpm;
        tempo.set(bpm);
        updateLaya();
        render();
        save();
        if (wasRunning) start();
      });
      taalCtl.select(taal.id);
    }

    const sched = new Scheduler({
      stepDuration: () => 60 / bpm,
      onSchedule: ({ step, time, duration }) => {
        const matra = step % taal.matras;
        const info = matraInfo(taal)[matra];
        const sa = saHz();
        if (sound !== 'claps') {
          const bols = taal.theka[matra];
          bols.forEach((b, k) => tablaStroke(b, time + (k * duration) / bols.length, sa, matra === 0 && k === 0 ? 1.15 : 1));
        }
        if (sound !== 'tabla' && info.first) {
          const kind = markKind(info.mark);
          if (kind === 'khali') wave(time);
          else clap(time, kind === 'sam');
        }
      },
      onVisual: ({ step }) => {
        const matra = step % taal.matras;
        highlight(matra);
        avOut.textContent = `āvartan ${Math.floor(step / taal.matras) + 1}`;
      },
    });

    function start() {
      audio();
      sched.start();
      setPressed(playBtn, true);
    }
    function stop() {
      sched.stop();
      setPressed(playBtn, false);
      highlight(-1);
      avOut.textContent = 'āvartan 0';
    }
    registerStopper(stop);
    playBtn.addEventListener('click', () => (sched.running ? stop() : start()));

    render();
  });
</script>

<style>
  .taal {
    display: grid;
    gap: var(--space-6);
  }
  .taal__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }
  @media (max-width: 760px) {
    .taal__main {
      grid-template-columns: 1fr;
    }
  }
  .taal__wheel-wrap {
    position: relative;
    width: min(100%, 360px);
    margin-inline: auto;
  }
  .taal__wheel {
    width: 100%;
    overflow: visible;
  }
  .taal__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }
  .taal__matra {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .taal__bol {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
    font-style: italic;
  }
  .taal__avartan {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: var(--tracking-wide);
  }

  /* SVG wheel parts (created in script, hence :global) */
  .taal :global(.taal__track) {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .taal :global(.taal__arc) {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke: var(--color-accent);
    opacity: 0.55;
  }
  .taal :global(.taal__arc--sam) {
    stroke: var(--color-sam);
  }
  .taal :global(.taal__arc--khali) {
    stroke: var(--color-khali);
    stroke-dasharray: 3 6;
  }
  .taal :global(.taal__pointer) {
    transform-origin: 170px 170px;
    transform-box: view-box;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .taal :global(.taal__pointer.is-hidden) {
    opacity: 0;
  }
  .taal :global(.taal__pointer line) {
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .taal :global(.taal__node circle:first-child) {
    fill: var(--color-surface-2);
    stroke: var(--color-border-strong);
    stroke-width: 1;
    transition: fill var(--duration-fast), r var(--duration-fast);
  }
  .taal :global(.taal__node-num) {
    font: 600 12px var(--font-body);
    fill: var(--color-text-muted);
  }
  .taal :global(.taal__mark-bg) {
    fill: var(--color-bg);
  }
  .taal :global(.taal__mark) {
    font: 700 12px var(--font-body);
    fill: var(--color-accent);
  }
  .taal :global(.taal__node--sam .taal__mark) {
    fill: var(--color-sam);
  }
  .taal :global(.taal__node--khali .taal__mark) {
    fill: var(--color-khali);
  }
  .taal :global(.taal__node--sam circle:first-child) {
    stroke: var(--color-sam);
    stroke-width: 2;
  }
  .taal :global(.taal__node--khali circle:first-child) {
    stroke: var(--color-khali);
    stroke-dasharray: 3 3;
  }
  .taal :global(.taal__node.is-on circle:first-child) {
    fill: var(--color-accent);
    stroke: var(--color-accent);
    filter: drop-shadow(0 0 10px var(--color-accent));
  }
  .taal :global(.taal__node--sam.is-on circle:first-child) {
    fill: var(--color-sam);
    filter: drop-shadow(0 0 12px var(--color-sam));
  }
  .taal :global(.taal__node.is-on .taal__node-num) {
    fill: var(--color-accent-contrast);
  }

  .taal__side {
    display: grid;
    gap: var(--space-4);
  }
  .taal__feel {
    font-size: var(--text-sm);
  }
  .taal__hint {
    font-size: var(--text-sm);
  }
  .taal__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .lg {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    margin-right: 0.3rem;
    vertical-align: -1px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
  }
  .lg--sam {
    border-color: var(--color-sam);
  }
  .lg--khali {
    border-color: var(--color-khali);
    border-style: dashed;
  }

  /* Theka notation */
  .taal__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .taal :global(.taal__vibhag) {
    flex: 1 1 auto;
    display: grid;
    gap: var(--space-1);
  }
  .taal :global(.taal__vibhag-mark) {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    padding-left: var(--space-1);
  }
  .taal :global(.taal__vibhag--sam .taal__vibhag-mark) {
    color: var(--color-sam);
  }
  .taal :global(.taal__vibhag--khali .taal__vibhag-mark) {
    color: var(--color-khali);
  }
  .taal :global(.taal__cells) {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .taal :global(.taal__vibhag--khali .taal__cells) {
    background: var(--color-khali-soft);
  }
  .taal :global(.taal__cell) {
    flex: 1;
    min-width: 3.4rem;
    display: grid;
    justify-items: center;
    padding: var(--space-2) var(--space-1);
    text-align: center;
    transition: background var(--duration-fast);
  }
  .taal :global(.taal__cell + .taal__cell) {
    border-left: 1px solid var(--color-border);
  }
  .taal :global(.taal__cell-bol) {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.2;
  }
  .taal :global(.taal__cell-num) {
    font-size: 10px;
    color: var(--color-text-subtle);
  }
  .taal :global(.taal__cell.is-on) {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .taal :global(.taal__cell.is-on .taal__cell-num) {
    color: inherit;
  }
</style>
